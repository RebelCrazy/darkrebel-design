# Credenciales de administrador
ADMIN_USERNAME=darkrebel-admin

# SHA-256 en hexadecimal de la contraseña del panel.
# Generar con:
# node -e "console.log(require('crypto').createHash('sha256').update('TU_PASSWORD_AQUI').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Clave larga y aleatoria para firmar la cookie de sesion.
# Recomendada: 32+ caracteres.
ADMIN_SESSION_SECRET=
